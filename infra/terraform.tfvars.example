project_name = "sao-paulo-gateway-migration"
environment  = "dev"
aws_region   = "sa-east-1"

# Replace with actual built/pushed ECR image URIs for each version.
gateway_images = {
  v1 = "123456789012.dkr.ecr.sa-east-1.amazonaws.com/sao-paulo-gateway-migration-v1:latest"
  v2 = "123456789012.dkr.ecr.sa-east-1.amazonaws.com/sao-paulo-gateway-migration-v2:latest"
}

# Rollout percentages per logical region
v2_weights = {
  saopaulo = 10
  rio      = 10
  brasilia = 10
}

desired_count_per_service = 1
